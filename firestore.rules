rules_version = '2';

// 対象コレクション：
//   - users/{uid}                         … fcmToken / notificationSettings / labelNames / ストリーク集計
//   - users/{uid}/tasks/{taskId}          … 未完了タスク
//   - users/{uid}/completedTasks/{id}     … 完了済みタスク履歴
//   - reminders/{reminderId}              … uidフィールドで所有者を持つフラットなコレクション
//                                            （ランダム通知の連鎖予約はCloud Functionsが作成、
//                                              固定リマインダーはクライアントが作成）
//
// Cloud Functions（functions/index.js）はすべて Admin SDK 経由のため、
// このルールの影響を受けません（Admin SDKはセキュリティルールをバイパスします）。
// つまり以下のデータ形式チェックは「クライアント（react-app）が直接書き込む経路」だけを対象にしており、
// lastActionedReminderId・streakLastDate（Cloud Functions版のstreak更新）のようなAdmin SDK専用の
// フィールドは対象外（チェックしなくてもクライアントからは触れない）。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- データ形式チェック用ヘルパー ----
    // 「フィールドが存在する場合だけ型・値を確認する」方式にしている（hasOnly()で全項目を固定はしない）。
    // 理由：フィールドを1つ追加するたびにルールも直さないと保存できなくなる、という壊れ方を避けたいため。
    // 代わりに「書き込まれた値の形が壊れている（型違い・想定外の文字列など）のを防ぐ」ことに絞っている。
    function isDateStr(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTimeStr(v) {
      return v is string && v.matches('^[0-9]{1,2}:[0-9]{2}$');
    }

    // users/{uid}/tasks/{taskId} … taskService.saveTask / setTaskStatus / delayTaskWithLaterTime /
    // completeTask（クライアント版）が書き込むフィールドの形をチェックする。
    function isValidTaskWrite(data) {
      return
        (data.name is string || data.title is string) &&
        (!('status' in data) || data.status in ['未完了', '後でやる']) &&
        (!('repeat' in data) || data.repeat in ['none', 'daily', 'weekly', 'monthly', 'yearly']) &&
        (!('priority' in data) || data.priority in ['low', 'medium', 'high']) &&
        (!('urgency' in data) || data.urgency in ['today', 'thisWeek', 'whenFree']) &&
        (!('color' in data) || data.color is string) &&
        (!('enabled' in data) || data.enabled is bool) &&
        (!('dueDate' in data) || data.dueDate == null || isDateStr(data.dueDate)) &&
        (!('dueTime' in data) || data.dueTime == null || isTimeStr(data.dueTime)) &&
        (!('fixedReminders' in data) || data.fixedReminders is list) &&
        (!('laterCount' in data) || data.laterCount is number);
    }

    // users/{uid}/completedTasks/{id} … 完了済みタスクのスナップショット＋履歴用メタデータ。
    // 中身はtasksとほぼ同じ形だが、過去に書き込まれたtasksの形が将来変わっても履歴として残せるよう、
    // ここでは「履歴管理として新規に足したフィールド」だけを厳密にチェックする。
    function isValidCompletedTaskWrite(data) {
      return
        (!('originalTaskId' in data) || data.originalTaskId is string) &&
        (!('removedFromHistory' in data) || data.removedFromHistory is bool);
    }

    // users/{uid} 本体 … fcmToken・notificationSettings・labelNames・discoveredStatuses・
    // ストリーク集計（streakCurrent/streakLongest/streakLastDate、taskService側のクライアントトランザクション）。
    function isValidUserWrite(data) {
      return
        (!('fcmToken' in data) || data.fcmToken == null || data.fcmToken is string) &&
        (!('labelNames' in data) || data.labelNames is map) &&
        (!('notificationSettings' in data) || data.notificationSettings is map) &&
        (!('discoveredStatuses' in data) || data.discoveredStatuses is list) &&
        (!('streakCurrent' in data) || data.streakCurrent is number) &&
        (!('streakLongest' in data) || data.streakLongest is number) &&
        (!('streakLastDate' in data) || isDateStr(data.streakLastDate));
    }

    // users/{uid} 本体。fcmToken・notificationSettings・labelNames を保持する。
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && isValidUserWrite(request.resource.data);
    }

    // users/{uid}/tasks/{taskId} … 未完了タスク。
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && isValidTaskWrite(request.resource.data);
    }

    // users/{uid}/completedTasks/{completedTaskId} … 完了済みタスク履歴。
    match /users/{uid}/completedTasks/{completedTaskId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && isValidCompletedTaskWrite(request.resource.data);
    }

    // 上記2つ以外の users/{uid} 配下サブコレクションは現状存在しないため、意図的にここで拒否させている
    // （最後の catch-all に落ちる）。新しいサブコレクションを追加する場合は、専用の match を追加し、
    // その形式に合ったチェック関数も一緒に用意すること。汎用の {document=**} で受けてしまうと
    // 上のtasks/completedTasksのデータ形式チェックがまとめて無効化される（Firestoreのルールは
    // 一致した match すべての allow が OR で合成されるため）。

    // reminders はユーザーの配下ではなくフラットなコレクションのため、
    // ドキュメント自身の uid フィールドで所有者を判定する。
    match /reminders/{reminderId} {
      // 一覧取得(list)はクライアントが必ず where("uid","==",自分のuid) を付けてクエリするため、
      // このルールと矛盾しない範囲でのみ許可される（Firestoreはルールを満たせないクエリを拒否する）。
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;

      // 固定リマインダー(saveFixedReminders)の新規作成のみ許可。作成者は自分のuidを持つドキュメントしか作れない。
      // さらに fcmToken は「未指定(null)」か「本人の users/{uid}.fcmToken と一致する値」しか書き込めないようにする。
      // これが無いと、他人のfcmTokenを知っている（何らかの経路で漏れた）攻撃者が、
      // 自分のuidで reminders ドキュメントを作成しつつ fcmToken だけ他人のものを指定することで、
      // sendReminderNotifications（uidを見ずにfcmToken宛てへ送信する）経由で他人へ任意内容のプッシュ通知を
      // 送りつけられてしまう（taskId は攻撃者自身のtasksを参照するだけなので、この経路の悪用は防げない）。
      // taskId/kind/notifiedの形式チェックも合わせて行い、壊れた形のリマインダーが作られるのを防ぐ。
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && (
          !("fcmToken" in request.resource.data) || request.resource.data.fcmToken == null ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && request.resource.data.fcmToken == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fcmToken
          )
        )
        && (!("taskId" in request.resource.data) || request.resource.data.taskId is string)
        && (!("kind" in request.resource.data) || request.resource.data.kind in ["fixed", "batch", "daily"])
        && (!("notified" in request.resource.data) || request.resource.data.notified == false);

      // 未通知リマインダーの取り消し(cancelPendingReminders / clearFixedReminders)用。
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      // クライアントはリマインダーを直接更新しない（作り直す場合は削除→新規作成）ため、更新は許可しない。
      // ランダム通知の連鎖予約(onTaskWritten/sendReminderNotifications)はAdmin SDKが更新するため、
      // ここを true にする必要はない。
      allow update: if false;
    }

    // 上記のどれにも一致しないパスは明示的に拒否（Firestoreのデフォルトも拒否だが、意図を明確にするため）。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
